{
  "manifest_version": 3,
  "name": "LuckyStrike OGame Helper",
  "version": "5.1.0",
  "description": "OGame helper: Maliyet Sepeti, Galaxy Scanner, Player Finder, Sesli Alarm, Harabe Avcısı",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "LuckyStrike OGame Helper"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.ogame.gameforge.com/game/index.php*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
