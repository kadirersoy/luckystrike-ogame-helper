{
  "manifest_version": 3,
  "name": "LuckyStrike OGame Helper",
  "version": "11.0",
  "permissions": [
    "notifications",
    "storage"
  ],
  "description": "OGame helper: Maliyet Sepeti, Toplayıcı, Postacı, Harabe Avcısı, Keşif Asistanı, Galaxy Scanner, Player Finder, Sesli Alarm",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "LuckyStrike OGame Helper"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.ogame.gameforge.com/game/index.php*"
      ],
      "js": [
        "bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.ogame.gameforge.com/game/index.php*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png"
      ],
      "matches": [
        "*://*.ogame.gameforge.com/*"
      ]
    }
  ]
}
